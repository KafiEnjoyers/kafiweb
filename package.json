		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"gsap": "^3.12.7"
	}
